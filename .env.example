# VK community access token. NEVER commit the real token.
VK_TOKEN=vk1.a.xxxxxxxx

# Community/group ID without the leading minus.
GROUP_ID=123456

# Main moderation chat: first message allowed, second within 1 hour is deleted + mute.
CHAT_PEER_ID=2000000001

# Separate VK conversation where BLOCKED_USER_IDS are removed immediately after joining.
BLOCKLIST_CHAT_PEER_ID=2000000002

# Optional comma-separated user IDs that must never be muted in the main moderation chat.
ADMIN_IDS=1,123456789

# Optional comma-separated VK user IDs that must be removed from BLOCKLIST_CHAT_PEER_ID.
BLOCKED_USER_IDS=111111111,222222222
