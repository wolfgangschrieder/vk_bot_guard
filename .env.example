# VK community access token. NEVER commit the real token.
VK_TOKEN=vk1.a.xxxxxxxx

# Community/group ID without the leading minus.
GROUP_ID=123456

# The ONLY VK conversation the bot is allowed to moderate.
# Example: 2000000001
CHAT_PEER_ID=2000000001

# Optional comma-separated user IDs that must never be muted.
ADMIN_IDS=1,123456789

# Optional comma-separated VK user IDs that must be removed from the chat immediately after joining.
BLOCKED_USER_IDS=111111111,222222222
