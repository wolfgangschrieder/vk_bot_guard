# VK community access token. NEVER commit the real token.
VK_TOKEN=vk1.a.xxxxxxxx

# Community/group ID without the leading minus.
GROUP_ID=123456

# Main feature chat: king, reputation, profile, statistics.
CHAT_PEER_ID=2000000002

# Strict moderation chat: 1 message/hour + prohibited/adult content moderation.
MODERATION_CHAT_PEER_ID=2000000001

# Legacy blocklist chat. Leave empty/0 to disable it for now.
BLOCKLIST_CHAT_PEER_ID=0

# Optional comma-separated user IDs that must never be auto-muted.
ADMIN_IDS=1,123456789

# Optional comma-separated VK user IDs that must be removed from the blocklist chat.
BLOCKED_USER_IDS=111111111,222222222

# Local timezone for 00:00/06:00/12:00/18:00 schedules.
CHAT_TIMEZONE=Europe/Moscow

# Optional actual numeric IDs of piterparker34, kenaya, id1122341522.
# Leave empty to resolve screen names via VK. Exactly three IDs if specified.
STAT_ALLOWED_IDS=
